	partition FactObjectifs = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\phich\OneDrive\Documents\IAE\class\BI\Eval 1\Jeu_donnees_Evaluation_PowerBI_2026.xlsx"), null, true),
				    TargetsSheet = Source{[Item="Objectifs_Mensuels",Kind="Sheet"]}[Data],
