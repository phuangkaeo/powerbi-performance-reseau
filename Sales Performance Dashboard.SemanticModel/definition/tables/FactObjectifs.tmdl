				    TrimmedText = Table.TransformColumns(PromotedHeaders, {{"StoreID", Text.Trim}, {"Categorie", Text.Trim}}),
				    ChangedTypes = Table.TransformColumnTypes(TrimmedText, {{"Mois", type date}, {"StoreID", type text}, {"Categorie", type text}, {"Objectif_CA", Currency.Type}, {"Objectif_Marge", Currency.Type}}),
				    RemovedDuplicates = Table.Distinct(ChangedTypes, {"Mois", "StoreID", "Categorie"})
