	partition FactVentes = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\phich\OneDrive\Documents\IAE\class\BI\Eval 1\Jeu_donnees_Evaluation_PowerBI_2026.xlsx"), null, true),
				    SalesSheet = Source{[Item="Ventes_TablePlate",Kind="Sheet"]}[Data],
				    PromotedHeaders = Table.PromoteHeaders(SalesSheet, [PromoteAllScalars=true]),
				    TrimmedText = Table.TransformColumns(PromotedHeaders, {{"StoreID", Text.Trim}, {"Categorie", Text.Trim}, {"Promo", Text.Trim}}),
				    ChangedTypes = Table.TransformColumnTypes(TrimmedText, {{"Date", type date}, {"StoreID", type text}, {"Categorie", type text}, {"Promo", type text}, {"TauxRemise", Percentage.Type}, {"UnitesVendues", Int64.Type}, {"NbClients", Int64.Type}, {"ChiffreAffaires", Currency.Type}, {"Cout", Currency.Type}, {"Marge", Currency.Type}}),
				    KeptFactColumns = Table.SelectColumns(ChangedTypes, {"Date","StoreID","Categorie","Promo","TauxRemise","UnitesVendues","NbClients","ChiffreAffaires","Cout","Marge"}),
				    AddedPromoFlag = Table.AddColumn(KeptFactColumns, "PromoFlag", each if [Promo] = "Oui" then 1 else 0, Int64.Type),
				    RemovedPromoText = Table.RemoveColumns(AddedPromoFlag, {"Promo"})
				in
				    RemovedPromoText

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

