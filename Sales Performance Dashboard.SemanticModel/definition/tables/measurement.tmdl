	measure 'User Greeting' = ```
			
			VAR CurrentHour = HOUR(NOW())
			VAR TimeGreeting = 
			    SWITCH(
			        TRUE(),
			        CurrentHour < 12, "Good morning",
			        CurrentHour < 18, "Good afternoon",
			        "Good evening,"
			    )
			VAR RawUser = "Phichet PHUANGKAEO"
			VAR ExtractedName = 
			    IF(
			        CONTAINSSTRING(RawUser, "@"),
			        LEFT(RawUser, FIND("@", RawUser) - 1),
			        IF(
			            CONTAINSSTRING(RawUser, "\"),
			            MID(RawUser, FIND("\", RawUser) + 1, 100),
			            RawUser
			        )
			    )
			VAR CleanName = SUBSTITUTE(ExtractedName, ".", " ")
			RETURN
			    TimeGreeting & UNICHAR(10) & CleanName
			```
		lineageTag: fd0ce1a7-b55f-4309-929c-972355abb00d

	measure 'Titre Page Top Flop' =
			
			VAR vAnnee = SELECTEDVALUE(DimDate[Année], "2024-2025")
			VAR vRegion =
			    IF(ISFILTERED(DimMagasin[Region]),
			       CONCATENATEX(VALUES(DimMagasin[Region]), DimMagasin[Region], ", "),
			       "Toutes régions")
			VAR vFormat =
			    IF(ISFILTERED(DimMagasin[Format]),
			       CONCATENATEX(VALUES(DimMagasin[Format]), DimMagasin[Format], ", "),
			       "Tous formats")
			VAR vCategorie =
			    IF(ISFILTERED(DimCategorie[Categorie]),
			       CONCATENATEX(VALUES(DimCategorie[Categorie]), DimCategorie[Categorie], ", "),
			       "Toutes catégories")
			VAR vKPI =
			    SWITCH(SELECTEDVALUE('KPI'[KPI Order], 0), 0, "CA", 1, "Nb Clients", 2, "Marge")
			RETURN
			"Top / Flop magasins par " & vKPI & "  |  " & vAnnee & "  ·  " & vRegion & "  ·  " & vFormat & "  ·  " & vCategorie
		lineageTag: 46f43da7-f2b0-45d9-944e-62739315c48c

	measure 'Titre Volume' =
			
			"Volume : " & FORMAT([Uplift unités promo %], "+0%;-0%") & " d'unités en promo"
		lineageTag: c42e1468-bdbc-4466-8cea-e4df7429ee29

	measure 'Titre CA promo' =
			
