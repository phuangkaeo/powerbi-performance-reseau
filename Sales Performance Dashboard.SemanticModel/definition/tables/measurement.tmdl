		lineageTag: 8f344faa-aa78-42f9-acef-525c9f3c16a7

	measure 'Titre Marge promo' =
			
			"Marge : " & FORMAT([Impact marge promo %], "+0.0%;-0.0%") & " par jour de promo"
		lineageTag: b8c3fd55-8411-4ddf-bea4-825ca7111fbd

	measure 'Titre Page Promo' =
			
			VAR vAnnee = SELECTEDVALUE(DimDate[Année], "2024-2025")
			VAR vRegion =
			    IF(ISFILTERED(DimMagasin[Region]),
			       CONCATENATEX(VALUES(DimMagasin[Region]), DimMagasin[Region], ", "),
			       "Toutes régions")
			VAR vFormat =
			    IF(ISFILTERED(DimMagasin[Format]),
			       CONCATENATEX(VALUES(DimMagasin[Format]), DimMagasin[Format], ", "),
			       "Tous formats")
			VAR vCategorie =
			    IF(ISFILTERED(DimCategorie[Categorie]),
			       CONCATENATEX(VALUES(DimCategorie[Categorie]), DimCategorie[Categorie], ", "),
			       "Toutes catégories")
			RETURN
			"Promotions  |  " & vAnnee & "  ·  " & vRegion & "  ·  " & vFormat & "  ·  " & vCategorie
		lineageTag: 1a7340ad-be2f-405e-92ae-0bbf97339a91

	partition measurement = m
		mode: import
		source =
				let
				    Source = Table.FromRows(Json.Document(Binary.Decompress(Binary.FromText("i44FAA==", BinaryEncoding.Base64), Compression.Deflate)), let _t = ((type nullable text) meta [Serialized.Text = true]) in type table [Column1 = _t]),
				    #"Changed Type" = Table.TransformColumnTypes(Source,{{"Column1", type text}}),
				    #"Removed Columns" = Table.RemoveColumns(#"Changed Type",{"Column1"})
				in
				    #"Removed Columns"

	annotation PBI_ResultType = Table

