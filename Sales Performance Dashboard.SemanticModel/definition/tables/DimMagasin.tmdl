	partition DimMagasin = m
		mode: import
		source =
				let
				    Source = Excel.Workbook(File.Contents("C:\Users\phich\OneDrive\Documents\IAE\class\BI\Eval 1\Jeu_donnees_Evaluation_PowerBI_2026.xlsx"), null, true),
				    StoreSheet = Source{[Item="DimMagasin",Kind="Sheet"]}[Data],
				    PromotedHeaders = Table.PromoteHeaders(StoreSheet, [PromoteAllScalars=true]),
				    TrimmedText = Table.TransformColumns(PromotedHeaders, {{"StoreID", Text.Trim},{"StoreName", Text.Trim},{"Ville", Text.Trim},{"Region", Text.Trim},{"Format", Text.Trim},{"Segment", Text.Trim}}),
				    ChangedTypes = Table.TransformColumnTypes(TrimmedText, {{"StoreID", type text},{"StoreName", type text},{"Ville", type text},{"Region", type text},{"Format", type text},{"Segment", type text},{"Surface_m2", Int64.Type},{"DateOuverture", type date}}),
				    FixedRegion = Table.ReplaceValue(ChangedTypes, each [Region], each if [Ville] = "Villeurbanne" then "Est" else if [Ville] = "Montaudran" then "Sud-Ouest" else [Region], Replacer.ReplaceValue, {"Region"}),
				    AddedStoreLabel = Table.AddColumn(FixedRegion, "Magasin", each [StoreID] & " - " & [Ville], type text),
				    AddedFormatOrder = Table.AddColumn(AddedStoreLabel, "FormatOrdre", each if [Format] = "Hyper" then 1 else if [Format] = "Super" then 2 else 3, Int64.Type),
				    AddedSizeBand = Table.AddColumn(AddedFormatOrder, "TrancheSurface", each if [Surface_m2] < 1500 then "< 1500 m2" else if [Surface_m2] < 5000 then "1500-5000 m2" else "> 5000 m2", type text),
				    RemovedDuplicateKeys = Table.Distinct(AddedSizeBand, {"StoreID"})
				in
				    RemovedDuplicateKeys

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

