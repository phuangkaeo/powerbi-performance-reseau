		sourceColumn: [JourSemaine]

		annotation SummarizationSetBy = Automatic

	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS(
				    CALENDAR(
				        DATE(YEAR(MIN(FactVentes[Date])), 1, 1),
				        DATE(YEAR(MAX(FactVentes[Date])), 12, 31)
				    ),
				    "Année", YEAR([Date]),
				    "MoisNum", MONTH([Date]),
				    "Mois", FORMAT([Date], "mmm"),
				    "AnnéeMois", FORMAT([Date], "yyyy-mm"),
				    "Trimestre", "T" & QUARTER([Date]),
				    "JourSemaineNum", WEEKDAY([Date], 2),
				    "JourSemaine", FORMAT([Date], "ddd")
				)

	annotation PBI_Id = dddc6a28b0ce42fab301df2cbecbef24

